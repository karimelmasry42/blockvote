#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# In a git worktree, node_modules lives in the main worktree.
MAIN_WORKTREE_PATH="$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -n 1)"
CURRENT_WORKTREE_PATH="$(git rev-parse --show-toplevel)"

if [ -z "$MAIN_WORKTREE_PATH" ]; then
  MAIN_WORKTREE_PATH="$CURRENT_WORKTREE_PATH"
fi

# In a git worktree, packages/nextjs/node_modules does not exist.
# Temporarily symlink it to the main worktree so Next.js finds TypeScript
# without auto-installing, then run lint/tsc as normal from this worktree.
WORKTREE_NM="$CURRENT_WORKTREE_PATH/packages/nextjs/node_modules"
MAIN_NM="$MAIN_WORKTREE_PATH/packages/nextjs/node_modules"

cleanup() {
  if [ "$CREATED_SYMLINK" = "1" ] && [ -L "$WORKTREE_NM" ]; then
    rm "$WORKTREE_NM"
  fi
}
trap 'cleanup' EXIT INT TERM

CREATED_SYMLINK=0
if [ -L "$WORKTREE_NM" ]; then
  # Replace any existing (possibly broken/stale) symlink with a fresh one.
  rm "$WORKTREE_NM"
  ln -s "$MAIN_NM" "$WORKTREE_NM"
  CREATED_SYMLINK=1
elif [ ! -e "$WORKTREE_NM" ]; then
  ln -s "$MAIN_NM" "$WORKTREE_NM"
  CREATED_SYMLINK=1
fi

cd "$CURRENT_WORKTREE_PATH/packages/nextjs"
set +e
"$MAIN_NM/.bin/next" lint --max-warnings=0 && \
  "$MAIN_NM/.bin/tsc" --noEmit --incremental
EXIT_CODE=$?
set -e

exit $EXIT_CODE
